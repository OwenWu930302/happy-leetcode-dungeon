{
  // 開心每日刷題 · VS Code 任務
  // Ctrl+Shift+B            → 提交目前打開的解題檔（出招）
  // Ctrl+Shift+P → Run Test Task → 試跑目前打開的解題檔（試招）
  // 打開這個資料夾時會自動啟動遊戲伺服器（第一次 VS Code 會問你要不要允許自動任務）
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🎮 開心刷題：開始遊戲",
      "type": "shell",
      "command": "python lc.py game",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": false },
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "🚀 出招：提交目前這題",
      "type": "shell",
      "command": "python lc.py submit ${fileBasenameNoExtension}",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "🧪 試招：用範例測資試跑目前這題",
      "type": "shell",
      "command": "python lc.py test ${fileBasenameNoExtension}",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "🔄 同步官網進度",
      "type": "shell",
      "command": "python lc.py sync",
      "problemMatcher": []
    },
    {
      "label": "☁️ 推上 GitHub",
      "type": "shell",
      "command": "python lc.py push",
      "problemMatcher": []
    }
  ]
}
